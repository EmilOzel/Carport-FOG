@startuml
title Navigationsdiagram - Admin og Sælger

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundcorner 12

skinparam state {
    BackgroundColor white
    BorderColor black
    FontColor black
    StartColor black
    EndColor white
}

[*] --> Login

state "Login\n--\n/login" as Login
state "Brugerside\n--\n/bruger-side" as Brugerside
state "Sælgeroversigt\n--\n/saelger" as Saelger
state "Sælger ordre\n--\n/saelger/ordre/{id}" as SaelgerOrdre
state "Admin ordrer\n--\n/admin" as AdminOrdrer
state "Admin brugere\n--\n/admin/brugere" as AdminBrugere
state "Admin statistik\n--\n/admin/statistik" as AdminStatistik
state "Opret sælger\n--\n/admin/opret-saelger" as OpretSaelger
state "Log ud\n--\n/logout" as LogUd

Login --> Brugerside : POST /login korrekt
Login --> Login : POST /login forkert

Brugerside --> Saelger : rolle = sælger
Brugerside --> AdminOrdrer : rolle = admin
Brugerside --> LogUd : log ud
LogUd --> Login

Saelger --> SaelgerOrdre : vælg ordre
SaelgerOrdre --> Saelger : tilbage
SaelgerOrdre --> Saelger : POST /saelger/ordre/{id}/send-tilbud

AdminOrdrer --> AdminBrugere : administrer brugere
AdminOrdrer --> AdminStatistik : se statistik
AdminOrdrer --> OpretSaelger : opret sælger
AdminOrdrer --> AdminOrdrer : POST /admin/ordre/{id}/status
AdminOrdrer --> SaelgerOrdre : se ordre
AdminOrdrer --> LogUd : log ud

AdminBrugere --> AdminBrugere : POST /admin/bruger/{id}/rolle
AdminBrugere --> AdminBrugere : POST /admin/bruger/{id}/slet
AdminBrugere --> AdminOrdrer : tilbage

AdminStatistik --> AdminOrdrer : tilbage

OpretSaelger --> AdminBrugere : POST /admin/opret-saelger oprettet
OpretSaelger --> OpretSaelger : POST /admin/opret-saelger fejl

@enduml