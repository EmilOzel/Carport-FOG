@startuml
title Navigationsdiagram - Kunde

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundcorner 12

skinparam state {
    BackgroundColor white
    BorderColor black
    FontColor black
    StartColor black
    EndColor white
}

[*] --> Forside

state "Forside\n--\n/" as Forside
state "Login\n--\n/login" as Login
state "Opret konto\n--\n/opret-bruger" as OpretKonto
state "Brugerside\n--\n/bruger-side" as Brugerside
state "Log ud\n--\n/logout" as LogUd
state "Byg carport\n--\n/byg-carport" as BygCarport
state "Vælg mål og tagmateriale\n--\n/choose-dimensions" as VaelgMaal
state "Bestil tilbud\n--\n/tegning" as BestilTilbud
state "Mine ordrer\n--\n/mine-ordrer" as MineOrdrer
state "Ordredetaljer\n--\n/ordre/{ordreId}" as OrdreDetaljer
state "Betaling\n--\n/ordre/{id}/betal" as Betaling

Forside --> Login : vælg login
Forside --> OpretKonto : opret konto
Forside --> BygCarport : byg carport
Forside --> [*] : luk system

Login --> Brugerside : POST /login korrekt
Login --> Login : POST /login forkert
Login --> OpretKonto : opret konto

OpretKonto --> Login : POST /opret-bruger konto oprettet
OpretKonto --> OpretKonto : POST /opret-bruger fejl

Brugerside --> LogUd : log ud
LogUd --> Forside

Brugerside --> BygCarport : byg carport
BygCarport --> VaelgMaal : vælg carport

VaelgMaal --> BygCarport : tilbage
VaelgMaal --> BestilTilbud : POST /carport/order

BestilTilbud --> VaelgMaal : ret mål
BestilTilbud --> MineOrdrer : POST /bestil-tilbud

Brugerside --> MineOrdrer : se mine ordrer
MineOrdrer --> OrdreDetaljer : se detaljer
OrdreDetaljer --> MineOrdrer : tilbage

OrdreDetaljer --> OrdreDetaljer : POST /ordre/{id}/accepter
OrdreDetaljer --> OrdreDetaljer : POST /ordre/{id}/afvis
OrdreDetaljer --> Betaling : gå til betaling
Betaling --> Brugerside : POST /ordre/{id}/betal

@enduml