@startuml

class User {
    - int userId
    - String email
    - String passwordHash
    - String firstName
    - String lastName
    - String phone
    - String address
    - int zip
    - Role role
}

class Order {
    - int orderId
    - Date createdAt
    - String status
    - double totalPrice
}

class Carport {
    - double width
    - double length
    - RoofType roofType
    - boolean hasShed
}

class MaterialLine {
    - int quantity
    - double price
    - String description
}

class Role {
    <<enumeration>>
    CUSTOMER
    SALESPERSON
    ADMIN
}

class RoofType {
    <<enumeration>>
    FLAT
    RAISED
}

User "1" -- "0..*" Order : places
Order "1" -- "1" Carport : contains
Carport "1" -- "0..*" MaterialLine : consists of

@enduml